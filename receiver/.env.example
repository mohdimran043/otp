# Receiver configuration by environment variable.
#
# The two secrets have no defaults and the process refuses to start without them. The acknowledgement secret
# must be the same value the sender holds: it is the only thing besides the protocol and the shared directory
# that the two applications have in common.

OTP_RECEIVER_ACK_SECRET=change-me-and-use-the-same-value-on-the-sender
OTP_RECEIVER_JWT_SECRET=change-me-to-at-least-32-random-bytes

OTP_RECEIVER_DATABASE_URL=postgres://otp:otp@postgres:5432/otp_receiver?sslmode=disable

# Where captured frames, chunks, and merged files live.
OTP_RECEIVER_STORAGE_BACKEND=filesystem
OTP_RECEIVER_STORAGE_ROOT=/var/lib/otp/receiver

# The channel: frames are read out of the first directory, acknowledgements written into the second. Both
# have to be the same storage the sender sees.
#
# CAPTURE_SOURCE is only the source this receiver starts on — the Camera tab switches it while running, so
# this is the fallback rather than the last word. "file" reads PNGs out of CAPTURE_DIR. "browser" takes
# frames posted by a page holding a camera, which needs nothing of the host and is how a container with no
# device passed into it can still see a display. "camera" opens a V4L2 device on this machine, and appears
# only in a build that has it.
OTP_RECEIVER_CAPTURE_DIR=/var/lib/otp/shared/frames
OTP_RECEIVER_ACK_DIR=/var/lib/otp/shared
OTP_RECEIVER_CAPTURE_SOURCE=file

# Which hosts a merged file may be delivered to, comma-separated. There is no default on purpose: the
# callback URL crosses the optical channel from outside this machine, so a receiver with no allowlist would
# post files wherever the far side told it to. Empty means nothing is delivered — files still arrive, are
# verified, and can be downloaded from the UI.
OTP_RECEIVER_CALLBACK_ALLOWED_HOSTS=

# Reloadable while running: log level, idle interval, and the two decoder confidence floors.
OTP_RECEIVER_LOG_LEVEL=info
OTP_RECEIVER_CAPTURE_IDLE_INTERVAL=100ms
OTP_RECEIVER_DECODER_MIN_FINDER_SCORE=0.75
OTP_RECEIVER_DECODER_MIN_TIMING_SCORE=0.6

# Optional: must match the sender's key exactly if it is encrypting payloads.
# OTP_RECEIVER_ENCRYPTION_KEY_HEX=

# Optional: a simulated camera in front of the file source — clean, typical, harsh, or rolling-shutter.
# Without it a file-to-file deployment only shows that the decoder can read the encoder's own output.
# OTP_RECEIVER_CAPTURE_SIMULATE=typical

# Object storage instead of a local directory (OTP_RECEIVER_STORAGE_BACKEND above), for a
# receiver running as more than one instance. docker-compose.yml already runs a pinned minio and
# makes this bucket whether or not the backend is ever switched to "minio" — change the access
# and secret keys before this leaves a laptop.
OTP_RECEIVER_MINIO_ENDPOINT=minio:9000
OTP_RECEIVER_MINIO_ACCESS_KEY=otpreceiver
OTP_RECEIVER_MINIO_SECRET_KEY=otpreceiver-dev-secret
OTP_RECEIVER_MINIO_BUCKET=otp-receiver
OTP_RECEIVER_MINIO_USE_SSL=false
OTP_RECEIVER_MINIO_REGION=us-east-1
