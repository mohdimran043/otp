# Build output
bin/
dist/
node_modules/

# Local configuration and secrets
.env
*.local

# The demonstration's working files, which are regenerated by running it
demo/shared/
demo/colour-test.png
demo/chime.wav

# Bind-mount directories Docker creates in the working tree when a side is run from its own compose
# file. They hold the shared channel — frames going one way, acknowledgements coming back — and are
# created root-owned by the daemon, so they are neither ours to commit nor ours to remove.
sender/shared/
receiver/shared/

# The design specification and any other superpowers working notes. Kept locally, not published.
docs/superpowers/
