# Build output
bin/
dist/
node_modules/

# Local configuration and secrets
.env
*.local

# The demonstration's working files, which are regenerated by running it
demo/shared/
demo/colour-test.png
demo/chime.wav

# Bind-mount directories Docker creates in the working tree when a side is run from its own compose
# file. They hold the shared channel — frames going one way, acknowledgements coming back — and are
# created root-owned by the daemon, so they are neither ours to commit nor ours to remove.
sender/shared/
receiver/shared/

# A shared optical directory pointed to by OTP_SHARED_DIR when it lives at the repo root instead of
# inside either side's own directory. Same reasoning: root-owned frame/ack traffic, not ours to commit.
/shared-channel/

# The design specification and any other superpowers working notes. Kept locally, not published.
docs/superpowers/

# Kept locally rather than checked in: the end-to-end suite and the single-host demonstration stack.
e2e/
demo/

# Also kept locally: the host setup notes and the containerised test stack. `make test` checks for the
# compose file and falls back to the host toolchain when it is absent, so a clone without it still runs.
PREREQUISITES.md
docker-compose.test.yml
