# Sender configuration by environment variable.
#
# Every setting in sender.yaml has an equivalent here, and the environment wins — which is what
# lets one image serve every deployment. The two below have no defaults and the process refuses
# to start without them: a default signing secret is not a secret, and the acknowledgement
# channel is the one input the sender takes from outside itself.

OTP_SENDER_ACK_SECRET=change-me-to-a-long-random-value
OTP_SENDER_JWT_SECRET=change-me-to-at-least-32-random-bytes

OTP_SENDER_DATABASE_URL=postgres://otp:otp@postgres:5432/otp_sender?sslmode=disable

# Where uploads, chunks, and rendered frames live.
OTP_SENDER_STORAGE_BACKEND=filesystem
OTP_SENDER_STORAGE_ROOT=/var/lib/otp/sender

# The shared volume the receiver reads frames from and writes acknowledgements into.
OTP_SENDER_DISPLAY_DIR=/var/lib/otp/shared/frames
OTP_SENDER_ACK_DIR=/var/lib/otp/shared

# Where frames go. "file" writes PNGs into DISPLAY_DIR for a receiver reading the same directory.
# "none" writes nothing at all: the frames are still rendered and still counted, but only a camera
# pointed at the display will ever see them — the mode to use when the channel really is optical
# and a shared directory would be a second, invisible path for the same bytes. This is read once at
# startup, so changing it takes effect on the next restart, not on a reload.
OTP_SENDER_DISPLAY_SINK=file

# The optical profile. The grid is written into every frame header, so changing it needs a
# restart rather than a reload. Both the grid and the cell size can also be set per transfer from
# the New Transfer form, which overrides these for that transfer only.
OTP_SENDER_ENCODER=color8
OTP_SENDER_COMPRESSION=zstd
OTP_SENDER_FEC_CODEC=reed-solomon
OTP_SENDER_FEC_DATA_SHARDS=32
OTP_SENDER_FEC_PARITY_SHARDS=8
OTP_SENDER_GRID_WIDTH=128
OTP_SENDER_GRID_HEIGHT=128
OTP_SENDER_CELL_PIXELS=8

# The sweep that deletes transfers which never finished. A transfer stuck at pending or failed
# still holds every chunk and frame it wrote, and nothing else in the sender ever goes back for
# it, so without this it is a slow leak of storage for uploads nobody is returning to. Anything
# older than MAX_AGE that never reached "completed" is reaped exactly as a DELETE would reap it.
# Completed transfers are never touched by the sweep, however old they are.
OTP_SENDER_RETENTION_INTERVAL=1h
OTP_SENDER_RETENTION_MAX_AGE=24h

# Reloadable while running: log level, job concurrency, frame rate, brightness, gamma, window.
OTP_SENDER_LOG_LEVEL=info
OTP_SENDER_JOB_CONCURRENCY=4
OTP_SENDER_DISPLAY_FPS=10
OTP_SENDER_DISPLAY_WINDOW_SIZE=64

# Optional: 64 hex characters enables AES-256-GCM on every payload.
# OTP_SENDER_ENCRYPTION_KEY_HEX=

# Object storage instead of a local directory (OTP_SENDER_STORAGE_BACKEND above), for a sender
# running as more than one instance. docker-compose.yml already runs a pinned minio and makes
# this bucket whether or not the backend is ever switched to "minio" — change the access and
# secret keys before this leaves a laptop.
OTP_SENDER_MINIO_ENDPOINT=minio:9000
OTP_SENDER_MINIO_ACCESS_KEY=otpsender
OTP_SENDER_MINIO_SECRET_KEY=otpsender-dev-secret
OTP_SENDER_MINIO_BUCKET=otp-sender
OTP_SENDER_MINIO_USE_SSL=false
OTP_SENDER_MINIO_REGION=us-east-1
