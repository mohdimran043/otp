# The demonstration deployment: one machine standing in for two, sharing a directory.
OTP_SHARED_DIR=../demo/shared
OTP_SENDER_ACK_SECRET=demo-acknowledgement-secret-not-for-production
OTP_SENDER_JWT_SECRET=demo-jwt-secret-at-least-32-bytes-long-here
OTP_RECEIVER_ACK_SECRET=demo-acknowledgement-secret-not-for-production
OTP_RECEIVER_JWT_SECRET=demo-jwt-secret-at-least-32-bytes-long-here
OTP_SENDER_HTTP_PORT=8080
OTP_RECEIVER_HTTP_PORT=8081
OTP_SENDER_DISPLAY_FPS=25
OTP_SENDER_CELL_PIXELS=6
OTP_SENDER_GRID_WIDTH=96
OTP_SENDER_GRID_HEIGHT=96
OTP_RECEIVER_CALLBACK_ALLOWED_HOSTS=callback,localhost,127.0.0.1
